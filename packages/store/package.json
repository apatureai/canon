  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": { "prepack": "tsc -b", "test": "vitest run" },
  "dependencies": {
    "@apatureai/canon-context": "workspace:*",
