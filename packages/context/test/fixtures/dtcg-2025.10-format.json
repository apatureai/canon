{
  "palette": {
    "$type": "color",
    "blue": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0.4, 0.8],
        "alpha": 1
      }
    }
  },
  "button": {
    "$type": "color",
    "background": { "$value": "{palette.blue}" },
    "foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "alpha": 1
      }
    }
  },
  "button-primary": {
    "$extends": "{button}",
    "background": { "$value": { "$ref": "#/palette/blue/$value" } }
  },
  "button-muted": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [
        { "$ref": "#/palette/blue/$value/components/0" },
        { "$ref": "#/palette/blue/$value/components/1" },
        { "$ref": "#/palette/blue/$value/components/2" }
      ],
      "alpha": 0.5
    }
  }
}
