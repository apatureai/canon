{
  "name": "@apatureai/canon",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "publishConfig": { "access": "public" },
  "description": "UI DNA command line: the filesystem entry point. Resolves a DTCG token file from disk and builds a design-system context block from a project directory. Every read of the filesystem in this repo lives here; the libraries stay pure.",
  "license": "MIT",
  "author": "Aditya Prathapa",
  "repository": { "type": "git", "url": "git+https://github.com/apatureai/canon.git", "directory": "packages/cli" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "bin": { "ui-dna": "./dist/bin.js" },
  "files": ["dist", "worker"],
  "scripts": { "prepack": "tsc -b", "test": "vitest run" },
  "dependencies": {
    "@apatureai/canon-context": "workspace:*",
    "@apatureai/canon-reconcile": "workspace:*",
    "@apatureai/canon-schema": "workspace:*",
    "@apatureai/canon-store": "workspace:*",
    "tailwindcss-v3": "npm:tailwindcss@^3.4.19"
  }
}
