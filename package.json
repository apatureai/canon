{
  "name": "@uidna/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Apature UI DNA - canonical design-genome schema, extraction, versioning, and downstream read contract.",
  "license": "MIT",
  "author": "Aditya Prathapa",
  "repository": { "type": "git", "url": "git+https://github.com/apatureai/ui-dna.git" },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "ui-dna": "node packages/cli/dist/bin.js",
    "eval:dtcg-corpus": "pnpm typecheck && node scripts/dtcg-corpus-benchmark.mjs"
  },
  "dependencies": {
    "@uidna/context": "workspace:*",
    "@uidna/reconcile": "workspace:*",
    "@uidna/render": "workspace:*",
    "@uidna/schema": "workspace:*",
    "@uidna/store": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3"
    }
  }
}
