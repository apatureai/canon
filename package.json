{
  "name": "@uidna/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Apature UI DNA - canonical design-genome schema, extraction, versioning, and downstream read contract.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "drill:genome-lifecycle": "node scripts/genome-lifecycle-drill.mjs",
    "eval:dtcg-corpus": "pnpm typecheck && node scripts/dtcg-corpus-benchmark.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3"
    }
  }
}
